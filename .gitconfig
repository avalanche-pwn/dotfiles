[core]
	autocrlf = input
	pager = less -FRSX
	editor = vim
[user]
	name = Antoni Duda
	email = antoni.duda@programmer.net
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	stat = true
[color]
	ui = auto
[merge]
	tool = meld
[username]
	email = antoni.duda@programmer.net
[credential]
	helper = store
[alias]
	ci = commit
	st = status
	br = branch
	# From https://stackoverflow.com/questions/1057564/pretty-git-branch-graphs
	lg = log -n10 --graph --abbrev-commit --decorate --format=format:'%C(bold yellow)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
